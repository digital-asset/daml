load("@build_environment//:configuration.bzl", "ghc_version")
load("//rules_daml:daml.bzl", "daml_compile")
load("//daml-lf:daml-lf.bzl", "COMPILER_LF_VERSIONS", "DEFAULT_LF_VERSION")

# These packages contain all user facing logic and data types for daml-script.
# They are forced to be utility packages (i.e. have no serializable types) for ease of development in future
[
    daml_compile(
        name = "daml-script-{}".format(lf_version),
        srcs = glob(["**/*.daml"]),
        dependencies = [
            "//daml-script/daml/daml-script-stable:daml-script-stable-{}.dar".format(lf_version),
        ],
        disable_deprecated_exceptions = True,
        force_utility_package = True,
        # Force daml files to be under `daml` directory, to match previous behaviour
        generated_daml_source_directory = "daml",
        project_name = "daml-script",
        target = lf_version,
        version = ghc_version,
        visibility = ["//daml-script/daml:__pkg__"],
    )
    for lf_version in COMPILER_LF_VERSIONS
]

# Documentation for daml-script is generated as though the `Daml.Script.Stable` module is part of the main package, for ease of navigation
genrule(
    name = "daml-script-json-docs",
    srcs = ["//daml-script/daml/daml-script-stable:daml-script-stable-source"] + glob(["**/*.daml"]),
    outs = ["daml-script.json"],
    # Include daml-script/daml/daml-script-stable path hard coded, as extracting from rule is ugly and this path should never change
    cmd = """
        $(location //compiler/damlc) -- docs \
            --output=$(OUTS) \
            --package-name=daml-script \
            --format=Json \
            --target=2.dev \
            -Wno-deprecated-exceptions \
            --include=daml-script/daml/daml-script-stable \
            $(location Daml/Script.daml) \
            $(location Daml/Script/Internal.daml)
    """,
    tools = [
        "//compiler/damlc",
    ],
    visibility = ["//daml-script/daml:__pkg__"],
)

-- This pattern is part of Daml.Script.Internal.Questions.Submit.Error.Compatibility but had to be
-- separated out to avoid field name collisions
module Daml.Script.Internal.Questions.Submit.Error.Compatibility.ContractDoesNotImplementRequiringInterface (pattern ContractDoesNotImplementRequiringInterface) where

import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the ContractDoesNotImplementRequiringInterface variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern ContractDoesNotImplementRequiringInterface : AnyContractId -> TemplateTypeRep -> TemplateTypeRep -> TemplateTypeRep -> AnySubmitError
pattern ContractDoesNotImplementRequiringInterface {contractId, templateId, requiredInterfaceId, requiringInterfaceId} <- (fromAnySubmitError -> Some ContractDoesNotImplementRequiringInterfaceSubmitError {..})
  where ContractDoesNotImplementRequiringInterface contractId templateId requiredInterfaceId requiringInterfaceId = toAnySubmitError ContractDoesNotImplementRequiringInterfaceSubmitError {..}

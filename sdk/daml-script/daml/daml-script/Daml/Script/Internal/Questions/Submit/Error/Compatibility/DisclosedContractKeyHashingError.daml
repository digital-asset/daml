-- This pattern is part of Daml.Script.Internal.Questions.Submit.Error.Compatibility but had to be
-- separated out to avoid field name collisions
module Daml.Script.Internal.Questions.Submit.Error.Compatibility.DisclosedContractKeyHashingError (pattern DisclosedContractKeyHashingError) where

import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Commands (AnyContractKey)
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the DisclosedContractKeyHashingError variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern DisclosedContractKeyHashingError : AnyContractId -> AnyContractKey -> Text -> AnySubmitError
pattern DisclosedContractKeyHashingError {contractId, expectedKey, givenKeyHash} <- (fromAnySubmitError -> Some DisclosedContractKeyHashingErrorSubmitError {..})
  where DisclosedContractKeyHashingError contractId expectedKey givenKeyHash = toAnySubmitError DisclosedContractKeyHashingErrorSubmitError {..}

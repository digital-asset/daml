module Daml.Script.Internal.Questions.Submit.Error.Compatibility.InconsistentContractKey (pattern InconsistentContractKey) where

import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Commands (AnyContractKey)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the InconsistentContractKey variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern InconsistentContractKey : AnyContractKey -> AnySubmitError
pattern InconsistentContractKey {contractKey} <- (fromAnySubmitError -> Some InconsistentContractKeySubmitError {..})
  where InconsistentContractKey contractKey = toAnySubmitError InconsistentContractKeySubmitError {..}

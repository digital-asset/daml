module Daml.Script.Internal.Questions.Util
  ( module Daml.Script.Internal.Questions.Util
  , module Stable
  ) where

import Daml.Script.Internal.Questions.Util.Stable.AnyContractId as Stable

deriving instance Eq AnyContractId

-- | MOVE Daml.Script
instance Show AnyContractId where
  showsPrec d (AnyContractId _ cid) = showParen (d > app_prec) $
    showString "AnyContractId " . showsPrec (app_prec +1) cid
    where app_prec = 10

-- | MOVE Daml.Script
fromAnyContractId : forall t. Template t => AnyContractId -> Optional (ContractId t)
fromAnyContractId cid
  | templateId cid == templateTypeRep @t = Some (coerceContractId $ contractId cid)
  | otherwise = None

pattern ContractKeyNotFound {cknfContractKey} <- (fromAnySubmitError -> Some ContractKeyNotFoundSubmitError {contractKey = cknfContractKey})
  where ContractKeyNotFound contractKey = toAnySubmitError ContractKeyNotFoundSubmitError {..}


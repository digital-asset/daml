pattern ValidationFailed {vfCoid, vfSrcTemplateId, vfDstTemplateId, srcPackageName, dstPackageName, originalSignatories, originalNonSignatoryStakeholders, originalKeyOpt, recomputedSignatories, recomputedNonSignatoryStakeholders, recomputedKeyOpt} <- (fromAnyUpgradeErrorType -> Some ValidationFailedUpgradeError {coid = vfCoid, srcTemplateId = vfSrcTemplateId, dstTemplateId = vfDstTemplateId, ..})
  where ValidationFailed coid srcTemplateId dstTemplateId srcPackageName dstPackageName originalSignatories originalNonSignatoryStakeholders originalKeyOpt recomputedSignatories recomputedNonSignatoryStakeholders recomputedKeyOpt = toAnyUpgradeErrorType ValidationFailedUpgradeError {..}


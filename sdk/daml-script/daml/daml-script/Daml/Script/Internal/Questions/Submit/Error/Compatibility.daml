{-# LANGUAGE DuplicateRecordFields #-}

-- | This module defines the compatibility Pattern Synonyms for the various SubmitError types
-- and the show instances that depend on them.
-- Pattern synonyms are a way to provide a variant matching like syntax for types that are not variants.
-- For example, the
-- ```
--   pattern UnsupportedContractId : Text -> AnySubmitError
-- ```
-- Can be used to match on `AnySubmitError` as though it were a `UnsupportedContractId`, even though
-- `AnySubmitError` does not have a constructor named `UnsupportedContractId`.
-- This allows for backwards compatibility with code that was written against the old `SubmitError` type, 
-- which did have a constructor named `UnsupportedContractId`, but was not cross-sdk compatible.
module Daml.Script.Internal.Questions.Submit.Error.Compatibility
  ( module Daml.Script.Internal.Questions.Submit.Error.Compatibility
  , module Patterns
  ) where

import qualified DA.Exception
import DA.Fail
import DA.Foldable (foldMap)
import DA.NonEmpty
import DA.Text
import Daml.Script.Internal.Questions.Commands (AnyContractKey)
import Daml.Script.Internal.Questions.Submit.Error
-- Some pattern synonyms are split out to avoid field name collisions, which GHC does not allow from the same module
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.AuthenticationFailed as Patterns (pattern AuthenticationFailed)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.ContractDoesNotImplementInterface as Patterns (pattern ContractDoesNotImplementInterface)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.ContractDoesNotImplementRequiringInterface as Patterns (pattern ContractDoesNotImplementRequiringInterface)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.DisclosedContractKeyHashingError as Patterns (pattern DisclosedContractKeyHashingError)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.InconsistentContractKey as Patterns (pattern InconsistentContractKey)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.TranslationFailed as Patterns (pattern TranslationFailed)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.UpgradeError as Patterns (pattern UpgradeError)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.ValidationFailed as Patterns (pattern ValidationFailed)
import Daml.Script.Internal.Questions.Submit.Error.Compatibility.WronglyTypedContract as Patterns (pattern WronglyTypedContract)
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility alias
type SubmitError = AnySubmitError
-- | MOVE Daml.Script
-- Backwards compatibility alias
type UpgradeErrorType = AnyUpgradeErrorType
-- | MOVE Daml.Script
-- Backwards compatibility alias
type CryptoErrorType = AnyCryptoErrorType
-- | MOVE Daml.Script
-- Backwards compatibility alias
type ExternalCallErrorType = AnyExternalCallErrorType
-- | MOVE Daml.Script
-- Backwards compatibility alias
type DevErrorType = AnyDevErrorType

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the ContractNotFound variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern ContractNotFound : NonEmpty Text -> Optional ContractNotFoundAdditionalInfo -> AnySubmitError
pattern ContractNotFound {unknownContractIds, additionalDebuggingInfo} <- (fromAnySubmitError -> Some ContractNotFoundSubmitError {..})
  where ContractNotFound unknownContractIds additionalDebuggingInfo = toAnySubmitError ContractNotFoundSubmitError {..}


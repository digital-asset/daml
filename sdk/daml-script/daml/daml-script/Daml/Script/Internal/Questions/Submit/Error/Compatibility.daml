pattern UnsupportedContractId {unknownContractId} <- (fromAnySubmitError -> Some UnsupportedContractIdSubmitError {..})
  where UnsupportedContractId unknownContractId = toAnySubmitError UnsupportedContractIdSubmitError {..}


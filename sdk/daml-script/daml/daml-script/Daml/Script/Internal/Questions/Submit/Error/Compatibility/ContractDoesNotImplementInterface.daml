module Daml.Script.Internal.Questions.Submit.Error.Compatibility.ContractDoesNotImplementInterface (pattern ContractDoesNotImplementInterface) where

-- This pattern is part of Daml.Script.Internal.Questions.Submit.Error.Compatibility but had to be
-- separated out to avoid field name collisions
import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the ContractDoesNotImplementInterface variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern ContractDoesNotImplementInterface : AnyContractId -> TemplateTypeRep -> TemplateTypeRep -> AnySubmitError
pattern ContractDoesNotImplementInterface {contractId, templateId, interfaceId} <- (fromAnySubmitError -> Some ContractDoesNotImplementInterfaceSubmitError {..})
  where ContractDoesNotImplementInterface contractId templateId interfaceId = toAnySubmitError ContractDoesNotImplementInterfaceSubmitError {..}

  toAnyUpgradeErrorType TranslationFailedUpgradeError {..} = make "TranslationFailed" ["mCoid", "srcTemplateId", "dstTemplateId", "createArg"] [Cast mCoid, Cast srcTemplateId, Cast dstTemplateId, Cast createArg]
  fromAnyUpgradeErrorType (match "TranslationFailed" ["mCoid", "srcTemplateId", "dstTemplateId", "createArg"] -> Some [Cast mCoid, Cast srcTemplateId, Cast dstTemplateId, Cast createArg]) = Some TranslationFailedUpgradeError {..}
  fromAnyUpgradeErrorType _ = None


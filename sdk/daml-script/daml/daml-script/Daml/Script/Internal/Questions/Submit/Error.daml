-- | MOVE Daml.Script
-- Generic catch-all for missing errors.
data UnknownErrorSubmitError = UnknownErrorSubmitError with
  unknownErrorMessage : Text

-- | MOVE Daml.Script
instance IsSubmitError UnknownErrorSubmitError where
  toAnySubmitError UnknownErrorSubmitError {..} = make "UnknownError" ["unknownErrorMessage"] [Cast unknownErrorMessage]
  fromAnySubmitError (match "UnknownError" ["unknownErrorMessage"] -> Some [Cast unknownErrorMessage]) = Some UnknownErrorSubmitError {..}
  fromAnySubmitError _ = None

-- | MOVE Daml.Script
-- One of the above error types where the full exception body did not fit into the response, and was incomplete.
data TruncatedErrorSubmitError = TruncatedErrorSubmitError with
  truncatedErrorType : Text
    -- ^ One of the constructor names of SubmitFailure except DevError, UnknownError, TruncatedError
  truncatedErrorMessage : Text

-- | MOVE Daml.Script
instance IsSubmitError TruncatedErrorSubmitError where
  toAnySubmitError TruncatedErrorSubmitError {..} = make "TruncatedError" ["truncatedErrorType", "truncatedErrorMessage"] [Cast truncatedErrorType, Cast truncatedErrorMessage]
  fromAnySubmitError (match "TruncatedError" ["truncatedErrorType", "truncatedErrorMessage"] -> Some [Cast truncatedErrorType, Cast truncatedErrorMessage]) = Some TruncatedErrorSubmitError {..}
  fromAnySubmitError _ = None

-- ContractNotFoundAdditionalInfo is not stable/extensible as its constructors are internal, and only used for Show
-- | MOVE Daml.Script.Internal
-- Additional debugging information provided only by IDE Ledger
data ContractNotFoundAdditionalInfo
  = NotFound -- The generic "this contract does not exist"
  | NotActive with -- The contract did exist, but has since been archived
      additionalInfoCid : AnyContractId
  | NotEffective with -- The contract "will" exist, only thrown from the IDELedger where one can go backwards in time
      additionalInfoCid : AnyContractId
      effectiveAt : Text
  | NotVisible with -- The contract exists, but the readAs/actAs party union cannot see it
      additionalInfoCid : AnyContractId
      actAs : [Party]
      readAs : [Party]
      observers : [Party]
  deriving Show

-- | MOVE Daml.Script.Internal
-- Exacts nonactive contract ID from ContractNotFoundAdditionalInfo
isNotActive : ContractNotFoundAdditionalInfo -> Optional AnyContractId
isNotActive (NotActive {additionalInfoCid}) = Some additionalInfoCid
isNotActive _ = None

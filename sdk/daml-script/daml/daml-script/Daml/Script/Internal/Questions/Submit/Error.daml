-- | HIDE
-- Class used for constructing and destructing TaggedRecords
-- Intended to be used by newtypes around the TaggedRecord which implement this class with simple wrappers
-- See AnySubmitError for example
class IsTaggedRecord a where
  match
    :  Text -- Variant name
    -> [Text] -- Field names
    -> a -- The TaggedRecord wrapper
    -> Optional [LedgerValue] -- Returns list of values of fields in FieldNames
  make 
    :  Text -- Variant name
    -> [Text] -- Field names
    -> [LedgerValue] -- Field values
    -> a

-- | HIDE
-- Root IsTaggedRecord instance which types like AnySubmitError wrap via newtype deriving
instance IsTaggedRecord TaggedRecord where
  match name fields taggedRecord = guard (name == tgTag taggedRecord) *> mapA (flip Map.lookup $ tgData taggedRecord) fields
  make name fields values = TaggedRecord name $ Map.fromList $ zip fields values
 
-- | HIDE
-- AnySubmitError is stable, but this instance is not.
instance IsTaggedRecord AnySubmitError where
  match name fields (AnySubmitError taggedRecord) = match name fields taggedRecord
  make name fields values = AnySubmitError $ make name fields values

-- | MOVE Daml.Script
-- Allows casting AnySubmitError into and out of specific errors.
class IsSubmitError e where
  -- | Transform a submit error into an AnySubmitError
  toAnySubmitError : e -> AnySubmitError
  -- | Attempt to transform an AnySubmitError into a specific submit error, gives `None` if the underlying type of the AnySubmitError
  -- does not match.
  -- This can be used with type application, i.e. `fromAnySubmitError @UnsupportedContractIdSubmitError`
  -- or forced with view patterns:
  -- ```
  --   case anySubmitError of
  --     (fromAnySubmitError -> UnsupportedContractIdSubmitError {..}) -> ...
  -- ```
  fromAnySubmitError : AnySubmitError -> Optional e

-- | HIDE
-- AnyUpgradeErrorType is stable, but this instance is not.
instance IsTaggedRecord AnyUpgradeErrorType where
  match name fields (AnyUpgradeErrorType taggedRecord) = match name fields taggedRecord
  make name fields values = AnyUpgradeErrorType $ make name fields values

-- | MOVE Daml.Script
-- SCU related submission errors
-- Allows casting AnyUpgradeErrorType into and out of specific upgrade error types.
class IsUpgradeErrorType e where
  -- | Transform an upgrade error type into an AnyUpgradeErrorType
  toAnyUpgradeErrorType : e -> AnyUpgradeErrorType
  -- | Attempt to transform an AnyUpgradeErrorType into a specific upgrade error type, gives `None` if the underlying type of the AnyUpgradeErrorType
  -- does not match.
  fromAnyUpgradeErrorType : AnyUpgradeErrorType -> Optional e

-- | MOVE Daml.Script
data ValidationFailedUpgradeError = ValidationFailedUpgradeError with
  coid : AnyContractId
  srcTemplateId : TemplateTypeRep
  dstTemplateId : TemplateTypeRep
  srcPackageName : Text
  dstPackageName : Text
  originalSignatories : [Party]
  originalNonSignatoryStakeholders : [Party]
  originalKeyOpt : Optional (AnyContractKey, [Party])
  recomputedSignatories : [Party]
  recomputedNonSignatoryStakeholders : [Party]
  recomputedKeyOpt : Optional (AnyContractKey, [Party])

-- | MOVE Daml.Script
instance IsUpgradeErrorType ValidationFailedUpgradeError where
  toAnyUpgradeErrorType ValidationFailedUpgradeError {..} = make "ValidationFailed" ["coid", "srcTemplateId", "dstTemplateId", "srcPackageName", "dstPackageName", "originalSignatories", "originalNonSignatoryStakeholders", "originalKeyOpt", "recomputedSignatories", "recomputedNonSignatoryStakeholders", "recomputedKeyOpt"] [Cast coid, Cast srcTemplateId, Cast dstTemplateId, Cast srcPackageName, Cast dstPackageName, Cast originalSignatories, Cast originalNonSignatoryStakeholders, Cast originalKeyOpt, Cast recomputedSignatories, Cast recomputedNonSignatoryStakeholders, Cast recomputedKeyOpt]
  fromAnyUpgradeErrorType (match "ValidationFailed" ["coid", "srcTemplateId", "dstTemplateId", "srcPackageName", "dstPackageName", "originalSignatories", "originalNonSignatoryStakeholders", "originalKeyOpt", "recomputedSignatories", "recomputedNonSignatoryStakeholders", "recomputedKeyOpt"] -> Some [Cast coid, Cast srcTemplateId, Cast dstTemplateId, Cast srcPackageName, Cast dstPackageName, Cast originalSignatories, Cast originalNonSignatoryStakeholders, Cast originalKeyOpt, Cast recomputedSignatories, Cast recomputedNonSignatoryStakeholders, Cast recomputedKeyOpt]) = Some ValidationFailedUpgradeError {..}
  fromAnyUpgradeErrorType _ = None


-- Development feature exceptions
data DevErrorSubmitError = DevErrorSubmitError with -- We just give the error's simple class name and the prettied message it generates. Scripts doesn't need anything more right now.
  devErrorType : AnyDevErrorType
  devErrorMessage : Text

-- | MOVE Daml.Script
instance IsSubmitError DevErrorSubmitError where

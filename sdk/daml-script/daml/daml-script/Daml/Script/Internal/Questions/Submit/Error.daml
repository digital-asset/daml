  fromAnySubmitError (match "ExternalCallError" ["externalCallErrorType", "extensionId", "functionId", "externalCallErrorMessage"] -> Some [Cast externalCallErrorType, Cast extensionId, Cast functionId, Cast externalCallErrorMessage]) = Some ExternalCallErrorSubmitError {..}

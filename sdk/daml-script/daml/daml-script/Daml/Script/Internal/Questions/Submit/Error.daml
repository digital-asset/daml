-- | MOVE Daml.Script
-- Attempted to compare incomparable contract IDs. You're doing something very wrong.
-- Two contract IDs with the same prefix are incomparable if one of them is local and the other non-local
-- or if one is relative and the other relative or absolute with a different suffix.
data ContractIdComparabilitySubmitError = ContractIdComparabilitySubmitError with
  globalExistingContractId : Text
    -- ^ We do not know the template ID at time of comparison.

-- | MOVE Daml.Script
instance IsSubmitError ContractIdComparabilitySubmitError where
  toAnySubmitError ContractIdComparabilitySubmitError {..} = make "ContractIdComparability" ["globalExistingContractId"] [Cast globalExistingContractId]
  fromAnySubmitError (match "ContractIdComparability" ["globalExistingContractId"] -> Some [Cast globalExistingContractId]) = Some ContractIdComparabilitySubmitError {..}
  fromAnySubmitError _ = None

-- | MOVE Daml.Script
-- A value has been nested beyond a given depth limit
data ValueNestingSubmitError = ValueNestingSubmitError with
  limit : Int
    -- ^ Nesting limit that was exceeded

-- | MOVE Daml.Script
instance IsSubmitError ValueNestingSubmitError where
  toAnySubmitError ValueNestingSubmitError {..} = make "ValueNesting" ["limit"] [Cast limit]
  fromAnySubmitError (match "ValueNesting" ["limit"] -> Some [Cast limit]) = Some ValueNestingSubmitError {..}
  fromAnySubmitError _ = None

-- | MOVE Daml.Script
-- The transaction refers to locked contracts which are in the process of being created, transferred, or
-- archived by another transaction. If the other transaction fails, this transaction could be successfully retried.
data LocalVerdictLockedContractsSubmitError = LocalVerdictLockedContractsSubmitError with
  localVerdictLockedContracts : [AnyContractId]
    -- ^ Locked contract ids

-- | MOVE Daml.Script
instance IsSubmitError LocalVerdictLockedContractsSubmitError where
  toAnySubmitError LocalVerdictLockedContractsSubmitError {..} = make "LocalVerdictLockedContracts" ["localVerdictLockedContracts"] [Cast localVerdictLockedContracts]
  fromAnySubmitError (match "LocalVerdictLockedContracts" ["localVerdictLockedContracts"] -> Some [Cast localVerdictLockedContracts]) = Some LocalVerdictLockedContractsSubmitError {..}
  fromAnySubmitError _ = None

-- | MOVE Daml.Script
-- The transaction refers to locked keys which are in the process of being modified by another transaction.
data LocalVerdictLockedKeysSubmitError = LocalVerdictLockedKeysSubmitError with
  localVerdictLockedKeys : [AnyContractKey]
    -- ^ Locked contract keys

-- | MOVE Daml.Script
instance IsSubmitError LocalVerdictLockedKeysSubmitError where
  toAnySubmitError LocalVerdictLockedKeysSubmitError {..} = make "LocalVerdictLockedKeys" ["localVerdictLockedKeys"] [Cast localVerdictLockedKeys]
  fromAnySubmitError (match "LocalVerdictLockedKeys" ["localVerdictLockedKeys"] -> Some [Cast localVerdictLockedKeys]) = Some LocalVerdictLockedKeysSubmitError {..}
  fromAnySubmitError _ = None


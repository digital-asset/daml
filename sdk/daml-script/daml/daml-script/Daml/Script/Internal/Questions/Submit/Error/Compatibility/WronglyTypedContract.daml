-- This pattern is part of Daml.Script.Internal.Questions.Submit.Error.Compatibility but had to be
-- separated out to avoid field name collisions
module Daml.Script.Internal.Questions.Submit.Error.Compatibility.WronglyTypedContract (pattern WronglyTypedContract) where

import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the WronglyTypedContract variant of the original SubmitError
-- Prefer using AnySubmitError and `fromAnySubmitError` instead of this pattern synonym.
pattern WronglyTypedContract : AnyContractId -> TemplateTypeRep -> TemplateTypeRep -> AnySubmitError
pattern WronglyTypedContract {contractId, expectedTemplateId, actualTemplateId} <- (fromAnySubmitError -> Some WronglyTypedContractSubmitError {..})
  where WronglyTypedContract contractId expectedTemplateId actualTemplateId = toAnySubmitError WronglyTypedContractSubmitError {..}

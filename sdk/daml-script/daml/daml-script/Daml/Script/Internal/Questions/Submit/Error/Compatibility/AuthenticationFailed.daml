-- This pattern is part of Daml.Script.Internal.Questions.Submit.Error.Compatibility but had to be
-- separated out to avoid field name collisions
module Daml.Script.Internal.Questions.Submit.Error.Compatibility.AuthenticationFailed (pattern AuthenticationFailed) where

import Daml.Script.Internal.Questions.Submit.Error
import Daml.Script.Internal.Questions.Util (AnyContractId)

-- | MOVE Daml.Script
-- Backwards compatibility pattern for the AuthenticationFailed variant of the original UpgradeErrorType
-- Prefer using AnyUpgradeErrorType and `fromAnyUpgradeErrorType` instead of this pattern synonym.
pattern AuthenticationFailed : AnyContractId -> TemplateTypeRep -> TemplateTypeRep -> AnyTemplate -> AnyUpgradeErrorType
pattern AuthenticationFailed {coid, srcTemplateId, dstTemplateId, createArg} <- (fromAnyUpgradeErrorType -> Some AuthenticationFailedUpgradeError {..})
  where AuthenticationFailed coid srcTemplateId dstTemplateId createArg = toAnyUpgradeErrorType AuthenticationFailedUpgradeError {..}

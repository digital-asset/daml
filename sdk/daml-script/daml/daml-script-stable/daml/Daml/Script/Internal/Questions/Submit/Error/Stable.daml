-- This module contains the stable types for the Submit.Error daml-script questions

module Daml.Script.Internal.Questions.Submit.Error.Stable where

import DA.Map
import Daml.Script.Internal.LowLevel.Stable

-- Submit errors are extensible and nested, we use a generic tagged record internally for all submit errors
data TaggedRecord = TaggedRecord with
  tgTag : Text
  tgData : Map Text LedgerValue

-- | See IsSubmitError for details on how to use AnySubmitError
newtype AnySubmitError = AnySubmitError TaggedRecord

-- | See IsUpgradeErrorType for details on how to use AnyUpgradeErrorType
newtype AnyUpgradeErrorType = AnyUpgradeErrorType TaggedRecord

-- | See IsCryptoErrorType for details on how to use AnyCryptoErrorType
newtype AnyCryptoErrorType = AnyCryptoErrorType TaggedRecord

-- | See IsExternalCallErrorType for details on how to use AnyExternalCallErrorType
newtype AnyExternalCallErrorType = AnyExternalCallErrorType TaggedRecord

-- | See IsDevErrorType for details on how to use AnyDevErrorType
newtype AnyDevErrorType = AnyDevErrorType TaggedRecord

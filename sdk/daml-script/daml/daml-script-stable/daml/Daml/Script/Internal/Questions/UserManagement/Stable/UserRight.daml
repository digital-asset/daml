module Daml.Script.Internal.Questions.UserManagement.Stable.UserRight where

-- | MOVE Daml.Script
-- The rights of a user.
data UserRight
  = ParticipantAdmin
  | CanActAs Party
  | CanReadAs Party
  | CanReadAsAnyParty
  | CanExecuteAs Party
  | CanExecuteAsAnyParty
  | CanActAsAnyParty

module Daml.Script.Internal.Questions.TransactionTree.Stable.TreeIndex where

import Daml.Script.Internal.Questions.TransactionTree.Stable.CreatedIndexPayload

-- | MOVE Daml.Script
data TreeIndex t
  = CreatedIndex (CreatedIndexPayload t)
  | ExercisedIndex (ExercisedIndexPayload t)

-- | MOVE Daml.Script
data ExercisedIndexPayload t = ExercisedIndexPayload
  with
    templateId : TemplateTypeRep
    choice : Text
    offset : Int
    child : TreeIndex t

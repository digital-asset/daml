-- This module contains the stable types for the Crypto.Text daml-script questions

module Daml.Script.Internal.Questions.Crypto.Text.Stable.Secp256k1KeyPair where

-- Text fields here are annotated with the type synonyms that they should be,
-- however these synonyms aren't stable, so these types cannot depend on them.
-- Both synonyms were for Text, so Secp256k1KeyPair itself is unchanged.
-- | MOVE Daml.Script
-- Secp256k1 key pair generated by `secp256k1generatekeypair` for testing.
data Secp256k1KeyPair = Secp256k1KeyPair with
  privateKey : Text -- PrivateKeyHex
  publicKey : Text -- PublicKeyHex

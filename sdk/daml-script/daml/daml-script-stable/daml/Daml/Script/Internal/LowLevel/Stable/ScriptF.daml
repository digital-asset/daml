{-# LANGUAGE AllowAmbiguousTypes #-}

module Daml.Script.Internal.LowLevel.Stable.ScriptF where

import Daml.Script.Internal.LowLevel.Stable.Question
import Daml.Script.Internal.LowLevel.Stable.LedgerValue

-- Our entire scriptF type now is just a question from LedgerValue to LedgerValue, returning a
-- | HIDE
newtype ScriptF a = ScriptF (Question LedgerValue LedgerValue a)

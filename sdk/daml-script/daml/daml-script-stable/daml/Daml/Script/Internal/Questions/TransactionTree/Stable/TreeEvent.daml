module Daml.Script.Internal.Questions.TransactionTree.Stable.TreeEvent where

import Daml.Script.Internal.Questions.TransactionTree.Stable.Created
import Daml.Script.Internal.Questions.Util.Stable.AnyContractId

-- | MOVE Daml.Script
data TreeEvent
  = CreatedEvent Created
  | ExercisedEvent Exercised

-- | MOVE Daml.Script
data Exercised = Exercised
  with
    contractId : AnyContractId
    choice : Text
    argument : AnyChoice
    childEvents: [TreeEvent]

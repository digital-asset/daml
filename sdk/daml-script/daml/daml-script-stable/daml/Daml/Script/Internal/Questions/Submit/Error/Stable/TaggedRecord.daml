module Daml.Script.Internal.Questions.Submit.Error.Stable.TaggedRecord where

import DA.Map
import Daml.Script.Internal.LowLevel.Stable.LedgerValue

-- Submit errors are extensible and nested, we use a generic tagged record internally for all submit errors

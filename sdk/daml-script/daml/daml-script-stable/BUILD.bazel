load("@build_environment//:configuration.bzl", "ghc_version")
load("//bazel_tools:haskell.bzl", "da_haskell_binary")
load("//daml-lf:daml-lf.bzl", "COMPILER_LF_VERSIONS")
load("//rules_daml:daml.bzl", "daml_compile")

# These packages contain only stable data types (and all exceptions) from daml-script. See Daml/Script/Stable.daml for more information.
[
    daml_compile(
        name = "daml-script-stable-{}".format(lf_version),
        srcs = glob(["**/*.daml"]),
        disable_deprecated_exceptions = True,
        force_utility_package = True,
        # Force daml files to be under `daml` directory, to match previous behaviour
        generated_daml_source_directory = "daml",
        project_name = "daml-script-stable",
        target = lf_version,
        version = ghc_version,
        visibility = [
            "//daml-script/daml:__pkg__",
            "//daml-script/daml/daml-script:__pkg__",
        ],
    )
    for lf_version in COMPILER_LF_VERSIONS
]

da_haskell_binary(
    name = "generate-stable-packages-dar",
    srcs = glob(["src/**/*.hs"]),
    hackage_deps = [
        "base",
        "bytestring",
        "containers",
        "directory",
        "extra",
        "filepath",
        "ghc-lib-parser",
        "ghcide",
        "text",
        "zip",
    ],
    main_function = "DA.Daml.Script.StablePackages.main",
    src_strip_prefix = "src",
    visibility = ["//visibility:public"],
    deps = [
        "//compiler/daml-lf-ast",
        "//compiler/daml-lf-proto-encode",
        "//compiler/daml-project-config",
        "//compiler/damlc/daml-compiler",
        "//compiler/damlc/daml-lf-conversion",
        "//compiler/damlc/daml-lf-util",
        "//compiler/damlc/stable-packages:stable-packages-lib",
        "//component-version/hs:component-version-lib",
        "//libs-haskell/da-hs-base",
    ],
)

genrule(
    name = "gen-stable-packages-dar",
    srcs = [],
    outs = ["daml-script-stable-packages.dar"],
    cmd = "$(location :generate-stable-packages-dar) $(OUTS)",
    tools = [":generate-stable-packages-dar"],
    visibility = ["//visibility:public"],
)

# Stable source files exposed for docs generation in //daml-script/daml/daml-script
filegroup(
    name = "daml-script-stable-source",
    srcs = glob(["**/*.daml"]),
    visibility = ["//daml-script/daml/daml-script:__pkg__"],
)

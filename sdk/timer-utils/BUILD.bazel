load(
    "//bazel_tools:scala.bzl",
    "da_scala_library",
    "da_scala_test",
)

da_scala_library(
    name = "timer-utils",
    srcs = glob(["src/main/scala/**/*.scala"]),
    tags = ["maven_coordinates=com.daml:timer-utils:__VERSION__"],
    visibility = [
        "//visibility:public",
    ],
    deps = [],
)

da_scala_test(
    name = "timer-utils-tests",
    srcs = glob(["src/test/scala/**/*.scala"]),
    deps = [
        ":timer-utils",
        "//3rdparty/jvm/org/scalatest",
    ],
)

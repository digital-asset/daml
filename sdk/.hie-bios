#!/usr/bin/env bash
set -euo pipefail

bazel_target="${1:-//compiler/damlc:damlc@ghci@bios}"
bazel="$(command -v bazelisk || command -v bazel)"

hie_bios_flags() {
  # Build first: Bazel replays cached action stdout, which would pollute the flags.
  "$bazel" build $bazel_target >&2
  # Rewrite the @bios flags (one per line) for HLS, which runs here, not in the execroot.
  "$bazel" run $bazel_target \
    | awk -v execroot="$("$bazel" info execution_root)" '
      # Memory and GC settings meant for the GHCi process; HLS runs GHC inside its own process, so they do not apply.
      /^\+RTS$/, /^-RTS$/                    { next }

      # Drop -pgm{a,c,l,P} <rules_haskell cc_wrapper> so GHC uses its own C compiler and preprocessor:
      # the wrapper looks up clang relative to the Bazel execroot and fails when run from here.
      /^-pgm[aclP]$/                         { getline; next }

      # HLS runs Template Haskell in its own process, not an external interpreter.
      /^-fexternal-interpreter$/             { next }
      # Default runtime settings to embed in a built executable; HLS only type-checks, so it never uses them.
      /^-with-rtsopts=/                      { next }
      # grpc C core library. Added with da-hls (#13853) for an unrecorded reason; harmless to keep.
      /-lmerged_cbits/                       { next }

      # Make paths relative to this directory (rules_haskell#2325).
      { sub(execroot "/", ""); print }
    '
}
if [[ -z "${HIE_BIOS_OUTPUT-}" ]]; then
  hie_bios_flags
else
  hie_bios_flags >"$HIE_BIOS_OUTPUT"
fi

load(
    "//bazel_tools:haskell.bzl",
    "da_haskell_binary",
    "da_haskell_library",
)

da_haskell_library(
    name = "sandbox-helper",
    srcs = ["Sandbox.hs"],
    hackage_deps = [
        "aeson",
        "base",
        "bytestring",
        "containers",
        "directory",
        "extra",
        "filepath",
        "process",
        "safe",
        "safe-exceptions",
        "tasty",
        "text",

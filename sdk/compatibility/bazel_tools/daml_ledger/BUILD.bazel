    name = "runner",
    srcs = ["Main.hs"],
    hackage_deps = [
        "aeson",
        "base",
        "containers",
        "extra",
        "filepath",
        "jwt",
        "process",
        "semver",
        "tagged",
        "tasty",
        "tasty-hunit",
        "text",
        "time",
        "uuid",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":sandbox-helper",
        "//bazel_tools/environ_fix",
        "//compatibility/bazel_tools/test_utils",
        "@rules_haskell//tools/runfiles",
    ],
)

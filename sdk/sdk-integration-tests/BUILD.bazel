load("//bazel_tools:haskell.bzl", "da_haskell_library", "da_haskell_repl", "da_haskell_test")

# A REPL with all tests, used as bios for HLS
da_haskell_repl(
    name = "sdk-integration-tests@ghci",
    testonly = True,
    deps = [
        ":tests",
        ":utils",
    ],
)

os_dependent_libraries = [] if is_windows else [
    "//language-support/js/daml-types:npm_package",
    "//bazel/common:pty-wrapper.sh",
]

da_haskell_library(
    name = "utils",
    srcs = ["src/DA/Daml/SdkIntegrationTests/Utils.hs"],
    hackage_deps = [
        "aeson",
        "base",
        "bytestring",
        "conduit",
        "conduit-extra",
        "containers",
        "extra",
        "filepath",
        "hashable",
        "jwt",
        "tasty",
        "text",
        "unordered-containers",
    ],
    src_strip_prefix = "src",
    deps = [
        "//component-version/hs:component-version-class-lib",
        "//libs-haskell/bazel-runfiles",
        "//libs-haskell/da-hs-base",
        "//libs-haskell/test-utils",
    ],
)

da_haskell_test(
    name = "tests",
    timeout = "moderate",
    srcs = [
        "src/DA/Daml/SdkIntegrationTests/Tests.hs",
    ],
    args = [
        "$(location @pnpm//:pnpm)",
    ],
    data = [
        "//:java_rlocation_path",
        "//compiler/damlc/tests:generate-simple-dalf",
        "//release:dpm-sdk-release-tarball",
        "@pnpm",
        "@rules_java//toolchains:current_java_runtime",
    ] + os_dependent_libraries,
    # marked flaky for mvn originally; still flaky now? #14281
    flaky = False,
    hackage_deps = [
        "aeson",
        "base",
        "bytestring",
        "extra",
        "filepath",
        "http-client",
        "http-types",
        "lens",
        "lens-aeson",
        "monad-loops",
        "process",
        "stm",
        "tasty",
        "tasty-hunit",
        "text",
        "vector",
    ],
    main_function = "DA.Daml.SdkIntegrationTests.Tests.main",
    tags = ["cpu:2"],
    deps = [
        ":utils",
        "//component-version/hs:component-version-lib",
        "//libs-haskell/bazel-runfiles",
        "//libs-haskell/da-hs-base",
        "//libs-haskell/test-utils",
    ],
)

load("//bazel_tools:haskell.bzl", "da_haskell_library")

da_haskell_library(
    name = "daml-multi-ide",
    srcs = glob(["src/**/*.hs"]),
    hackage_deps = [
        "aeson",
        "async",
        "attoparsec",
        "base",
        "bytestring",
        "containers",
        "directory",
        "either",
        "extra",
        "filepath",
        "ghc-lib",
        "hashable",
        "lens",
        "lens-aeson",
        # Compatibility with types exposed by the single-package IDE.
        "lsp-types",
        "lsp-types-new",
        "monad-loops",
        "network-uri",
        "process",
        "some",
        "split",
        "stm",
        "text",
        "time",
        "transformers",
        "typed-process",
        "unordered-containers",
        "yaml",
        "zip-archive",
    ],
    src_strip_prefix = "src",
    visibility = ["//visibility:public"],
    deps = [
        "//compiler/daml-lf-ast",
        "//compiler/daml-lf-proto",
        "//compiler/daml-lf-reader",
        "//compiler/daml-project-config",
        "//compiler/damlc/daml-compiler",
        "//compiler/damlc/daml-ide",
        "//compiler/damlc/daml-ide-core",
        "//compiler/damlc/daml-opts:daml-opts-types",
        "//compiler/damlc/daml-package-config",
        "//compiler/damlc/daml-resolution-config",
        "//compiler/damlc/daml-rule-types",
        "//component-version/hs:component-version-class-lib",
        "//libs-haskell/da-hs-base",
    ],
)

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_run_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@build_environment//:configuration.bzl", "sdk_version")
load("@daml_extension_deps//:defs.bzl", "npm_link_all_packages")
load("@daml_extension_deps//compiler/daml-extension:@vscode/vsce/package_json.bzl", vsce = "bin")
load("@jq.bzl//jq:jq.bzl", "jq")
load("//bazel/js:flat_node_modules.bzl", "flat_node_modules")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "json-files",
    srcs = glob([
        "*.json",
        "syntaxes/*.json",
    ]),
)

sh_test(
    name = "valid-json",
    timeout = "short",
    srcs = ["ci-tests.sh"],
    args = [
        "$(location //bazel_tools:jq_bin)",
        "$(locations :json-files)",
    ],
    data = [
        ":json-files",
        "//bazel_tools:jq_bin",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

ts_project(
    name = "compile",
    srcs = glob(["src/**/*.ts"]),
    declaration = False,
    out_dir = "out",
    source_map = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/@types/node-fetch",
        ":node_modules/@types/semver",
        ":node_modules/@types/vscode",
        ":node_modules/@types/which",
        ":node_modules/@types/xml2js",
        ":node_modules/fp-ts",
        ":node_modules/node-fetch",
        ":node_modules/semver",
        ":node_modules/vscode-languageclient",
        ":node_modules/which",
        ":node_modules/xml2js",
    ],
)

genrule(
    name = "webview-stylesheet",
    srcs = ["src/webview.css"],
    outs = ["webview-stylesheet.css"],
    cmd = """
    cp "$(location src/webview.css)" "$@"
    """,
)

jq(
    name = "stamped_package_json",
    srcs = ["package.json"],
    filter = '(.version = "{}") | (.name = "daml-bundled")'.format(sdk_version),
)

flat_node_modules(
    name = "production_node_modules",
    deps = [
        ":node_modules/@types/semver",
        ":node_modules/@types/which",
        ":node_modules/@types/xml2js",
        ":node_modules/concat-map",
        ":node_modules/fp-ts",
        ":node_modules/node-fetch",
        ":node_modules/semver",
        ":node_modules/vscode-languageclient",
        ":node_modules/which",
        ":node_modules/xml2js",
    ],
)

copy_to_directory(
    name = "vsix_contents",
    srcs = [
        ".vscodeignore",
        "README.md",
        "src/webview.css",
        "src/webview.js",
        ":compile",
        ":production_node_modules",
        ":stamped_package_json",
    ] + glob([
        "*.configuration.json",
        "images/*",
        "snippets/*",
        "syntaxes/*",
    ]),
    replace_prefixes = {
        "production_node_modules/": "node_modules/",
        "stamped_package_json.json": "package.json",
    },
)

vsce.vsce_binary(
    name = "vsce",
    include_npm = True,
)

js_run_binary(
    name = "vsix",
    srcs = [":vsix_contents"],
    outs = ["daml-bundled.vsix"],
    args = [
        "package",
        "--out",
        "../daml-bundled.vsix",
    ],
    chdir = package_name() + "/vsix_contents",
    env = {"HOME": "/does-not-exist"},
    tool = ":vsce",
)

js_test(
    name = "vsix_smoke_test",
    timeout = "short",
    data = [
        ":vsix",
        "@bazel_tools//tools/zip:zipper",
    ],
    entry_point = "vsix_smoke_test.js",
    env = {
        "VSIX": "$(rlocationpath :vsix)",
        "ZIPPER": "$(rlocationpath @bazel_tools//tools/zip:zipper)",
    },
    no_copy_to_bin = ["@bazel_tools//tools/zip:zipper"],
)

exports_files([
    ".npmrc",
    "pnpm-lock.yaml",
])

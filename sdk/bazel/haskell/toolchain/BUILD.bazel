load("@os_info//:os_info.bzl", "is_darwin", "is_darwin_arm64", "is_linux_arm")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/native:configure_make.bzl", "configure_make")
load("//bazel/versions:ghc.version.bzl", "GHC_LLVM_BACKEND", "GHC_VERSION")
load(":defs.bzl", "ghc_smoke", "ghc_toolchain")
load(":ghc_bindist_install.bzl", "ghc_bindist_install")

_TINFO_SONAME = "libtinfo.so.6" if is_linux_arm else "libtinfo.so.5"

_AUTOTOOLS_TRIPLES = [
    "--build=aarch64-unknown-linux-gnu",
    "--host=aarch64-pc-linux-gnu",
] if is_linux_arm else [
    "--build=x86_64-unknown-linux-gnu",
    "--host=x86_64-pc-linux-gnu",
]

_TINFO_ARCH_FLAGS = _AUTOTOOLS_TRIPLES + ([] if is_linux_arm else ["--with-versioned-syms"])

_TINFO_DEB9_SYMBOL_MAP = None if is_linux_arm else "files/libtinfo5.map"

_HAS_GHC_LLVM_BACKEND = GHC_LLVM_BACKEND and (is_darwin_arm64 or is_linux_arm)

ghc_bindist_install(
    name = "ghc_install",
    srcs = "@ghc_bindist//:bindist_srcs",
    bz2 = None if is_darwin else "@bzip2//:libs",
    configure = "@ghc_bindist//:bindist_unpacked/configure",
    gmp = None if is_darwin else "@gmp//:libs",
    libz = None if is_darwin else "@libz//:libs",
    llvm_backend = "@ghc_llvm_backend//:backend" if _HAS_GHC_LLVM_BACKEND else None,
    make = "@make//:make",
    tinfo = None if is_darwin else ":" + _TINFO_SONAME,
)

filegroup(
    name = "install_tree",
    srcs = [":ghc_install"],
    output_group = "install_tree",
)

genrule(
    name = "ghc_pkg_bin",
    srcs = [":install_tree"],
    outs = ["ghc-pkg"],
    cmd = 'cp -L "$(location :install_tree)/lib/bin/ghc-pkg" "$@"',
    executable = True,
)

toolchain_type(name = "ghc_toolchain_type")

ghc_toolchain(
    name = "ghc_impl",
    install = ":ghc_install",
    version = GHC_VERSION,
)

toolchain(
    name = "ghc_linux_amd64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":ghc_impl",
    toolchain_type = ":ghc_toolchain_type",
)

toolchain(
    name = "ghc_linux_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    toolchain = ":ghc_impl",
    toolchain_type = ":ghc_toolchain_type",
)

toolchain(
    name = "ghc_darwin_arm64",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    toolchain = ":ghc_impl",
    toolchain_type = ":ghc_toolchain_type",
)

ghc_smoke(name = "smoke")

configure_make(
    name = "tinfo",
    srcs = "@ncurses//:srcs",
    outs = [
        "libtinfo.so",
        _TINFO_SONAME,
    ],
    configure = "@ncurses//:configure",
    configure_flags = _TINFO_ARCH_FLAGS + [
        "--with-shared",
        "--with-termlib",
        "--without-debug",
        "--without-ada",
        "--without-cxx-binding",
        "--without-manpages",
        "--without-tests",
        "cf_cv_gcc_inline=no",
    ],
    extra_cflags = ["-Wno-implicit-function-declaration"],
    install_libdir = "lib",
    make = "@make//:make",
    target_compatible_with = ["@platforms//os:linux"],
    version_script = _TINFO_DEB9_SYMBOL_MAP,
)

cc_library(
    name = "tinfo_cc_lib",
    srcs = [] if is_darwin else [":" + _TINFO_SONAME],
    linkopts = ["-lncurses"] if is_darwin else [],
)

filegroup(
    name = "tinfo_libs",
    srcs = [] if is_darwin else [
        ":libtinfo.so",
        ":" + _TINFO_SONAME,
    ],
)

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory_bin_action")
load("@aspect_rules_js//js:providers.bzl", "JsInfo")

_COPY_TO_DIRECTORY_TOOLCHAIN = "@aspect_bazel_lib//lib:copy_to_directory_toolchain_type"

_PACKAGE_STORE = "/node_modules/.aspect_rules_js"

def _package_store_directories(deps):
    store_files = depset(transitive = [
        info.transitive_files
        for dep in deps
        for info in dep[JsInfo].npm_package_store_infos.to_list()
    ])
    return [file for file in store_files.to_list() if file.is_directory]

def _store_location(directory):
    store_root, _, store_path = directory.short_path.partition(_PACKAGE_STORE + "/")
    store_name, _, package = store_path.partition("/node_modules/")
    return struct(
        root = store_root + _PACKAGE_STORE,
        name = store_name,
        package = package,
    )

def _flat_node_modules_impl(ctx):
    store_by_package = {}
    store_roots = {}
    directories = _package_store_directories(ctx.attr.deps)
    for directory in directories:
        location = _store_location(directory)
        linked_store = store_by_package.setdefault(location.package, location.name)
        if linked_store != location.name:
            fail("{} cannot flatten {}: both {} and {} are required".format(
                ctx.label,
                location.package,
                linked_store,
                location.name,
            ))
        store_roots[location.root] = True

    output = ctx.actions.declare_directory(ctx.attr.name)
    copy_to_directory_bin_action(
        ctx,
        name = ctx.attr.name,
        dst = output,
        copy_to_directory_bin = ctx.toolchains[_COPY_TO_DIRECTORY_TOOLCHAIN].copy_to_directory_info.bin,
        files = directories,
        root_paths = store_roots.keys(),
        replace_prefixes = {
            "{}/node_modules/".format(store_name): ""
            for store_name in store_by_package.values()
        },
    )
    return [DefaultInfo(files = depset([output]))]

flat_node_modules = rule(
    implementation = _flat_node_modules_impl,
    attrs = {
        "deps": attr.label_list(providers = [JsInfo]),
    },
    toolchains = [_COPY_TO_DIRECTORY_TOOLCHAIN],
)

load(":platforms.bzl", "PLATFORMS")

package(default_visibility = ["//visibility:public"])

_EXTRA_PLATFORM_CONSTRAINTS = {
    "windows_x86_64": ["@llvm//constraints/windows/crt:msvcrt"],
}

[
    platform(
        name = p.name,
        constraint_values = p.constraints + _EXTRA_PLATFORM_CONSTRAINTS.get(p.name, []),
    )
    for p in PLATFORMS.values()
]

[
    config_setting(
        name = "is_" + p.name,
        constraint_values = p.constraints,
    )
    for p in PLATFORMS.values()
]

load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

_EXCLUDE_PATTERNS = [
    "./.bazelbsp/*",
]

buildifier(
    name = "check",
    exclude_patterns = _EXCLUDE_PATTERNS,
    mode = "diff",
    verbose = True,
)

buildifier(
    name = "update",
    exclude_patterns = _EXCLUDE_PATTERNS,
    mode = "fix",
    verbose = True,
)

buildifier_test(
    name = "buildifier_test",
    timeout = "short",
    exclude_patterns = _EXCLUDE_PATTERNS,
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

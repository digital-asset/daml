load("@rules_python//python:defs.bzl", "py_binary", "py_test")

_LOCKFILES = [
    "//:maven_install_2.13.json",
]

_ENV = {
    "MAVEN_LOCKFILES": " ".join(["$(rlocationpath %s)" % lockfile for lockfile in _LOCKFILES]),
}

py_binary(
    name = "akka",
    srcs = ["akka_ban.py"],
    data = _LOCKFILES,
    env = _ENV,
    main = "akka_ban.py",
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "akka_test",
    timeout = "short",
    srcs = ["akka_ban.py"],
    args = ["check"],
    data = _LOCKFILES,
    env = _ENV,
    main = "akka_ban.py",
    deps = ["@rules_python//python/runfiles"],
)
